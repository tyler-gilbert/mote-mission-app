    {
      "name": "Turn saturated at 45 degrees left",
      "timestamp": 5.0,
      "guidance": { "heading_deg": -45.0, "distance_m": 2000.0 },
      "expected": { "motor_drive": { "left_rad_per_s": 0.044, "right_rad_per_s": 1.5 } }
    },
    {
      "name": "Approaching, about a San Martin leg away, slowing",
      "timestamp": 6.0,
      "guidance": { "heading_deg": 0.0, "distance_m": 400.0 },
